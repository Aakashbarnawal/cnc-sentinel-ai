# =====================================================================
# CNC Sentinel AI — Production Environment Variables Configuration Template
# Copy this file to .env and provide your actual infrastructure credentials.
# NEVER commit your actual .env file or real secrets to version control.
# =====================================================================

# ---------------------------------------------------------------------
# 1. MongoDB Atlas Database Configuration (Required)
# ---------------------------------------------------------------------
# Standard MongoDB Atlas connection string:
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DATABASE=predictive_maintenance

# ---------------------------------------------------------------------
# 2. Server Host, Port, and CORS Configuration
# ---------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
# Comma-separated list of allowed frontend origins (or * for public testing):
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_BASE_URL=http://localhost:3000

# ---------------------------------------------------------------------
# 3. SMTP Email Notification & Health Report Service (Optional)
# ---------------------------------------------------------------------
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
ALERT_RECIPIENT_EMAIL=
SMTP_USE_TLS=true
EMAIL_COOLDOWN_SEC=300

# ---------------------------------------------------------------------
# 4. Telegram Bot Alert Integration (Optional)
# ---------------------------------------------------------------------
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_COOLDOWN_SEC=60
